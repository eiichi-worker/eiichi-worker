{
  "filters": { "comments": true },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": false,
      "max-comma": false,
      "max-kanji-continuous-len": false,
      "arabic-kanji-numbers": false,
      "no-exclamation-question-mark": false,
      "ja-no-mixed-period": false,
      "ja-no-successive-word": false,
      "no-doubled-joshi": { "min_interval": 1 },
      "no-mix-dearu-desumasu": { "preferInBody": "ですます", "preferInList": "ですます" }
    },
    "preset-ja-spacing": {
      "ja-space-between-half-and-full-width": { "space": "never" },
      "ja-no-space-between-full-width": false,
      "ja-no-space-around-parentheses": false,
      "ja-space-around-code": { "before": true, "after": true }
    },
    "preset-jtf-style": {
      "1.1.1.本文": false,
      "1.1.3.箇条書き": false,
      "2.1.5.カギ括弧「」": false,
      "2.1.6.ダッシュ(-)": false,
      "2.1.8.算用数字": false,
      "3.1.1.全角文字と半角文字の間": false,
      "3.1.2.全角文字どうし": false,
      "3.3.かっこ類と隣接する文字の間のスペースの有無": false,
      "4.2.7.コロン(：)": false,
      "4.3.1.丸かっこ（）": false
    }
  },
  "ignoreFiles": ["node_modules/**", ".tmp/**"]
}
